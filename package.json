{
  "name": "nuvio",
  "private": true,
  "version": "0.1.0",
  "description": "Site institucional e API da Nuvio",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @nuvio/web",
    "dev:api": "npm run dev -w @nuvio/api",
    "build": "npm run build -w @nuvio/contracts && npm run build -w @nuvio/api && npm run build -w @nuvio/web",
    "build:api": "npm run build -w @nuvio/contracts && npm run build -w @nuvio/api",
    "start:api": "node apps/api/dist/main.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @nuvio/web",
    "test:a11y": "npm run test:a11y -w @nuvio/web",
    "audit": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@scarf/scarf@1.4.0": true
  }
}
