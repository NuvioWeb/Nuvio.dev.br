# Environment template — copy to apps/api/.env and apps/web/.env as needed.
# NEVER commit real secrets.

# --- API ---
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

# CORS allowlist (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://nuvio.dev.br

# Public site URL (canonical / Open Graph) — used by the web app
PUBLIC_SITE_URL=https://nuvio.dev.br

# Rate limiting (requests per TTL window)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10
THROTTLE_LEAD_LIMIT=5

# Body size limit
BODY_LIMIT_BYTES=65536

# Email: local | resend | smtp
# Leads are NOT stored in a database — only forwarded by email.
# Resend: API key begins with re_
EMAIL_PROVIDER=resend
EMAIL_FROM=Nuvio <contato@nuvio.dev.br>
EMAIL_TO=nuvioweb.enterprise@gmail.com
RESEND_API_KEY=

# Alternativa SMTP (Resend SMTP):
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_SECURE=true

# Optional Turnstile/CAPTCHA (leave empty to disable)
# TURNSTILE_SECRET_KEY=
# VITE_TURNSTILE_SITE_KEY=

# --- Web (Vite) ---
VITE_API_BASE_URL=http://localhost:3001
VITE_PUBLIC_SITE_URL=https://nuvio.dev.br
